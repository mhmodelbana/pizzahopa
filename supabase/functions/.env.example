# Set with `supabase secrets set`, do not commit actual values.
HOPA_RATE_LIMIT_SALT=
# Comma-separated origin allowlist; omit to keep wildcard CORS during initial testing.
HOPA_ALLOWED_ORIGINS=https://your-domain.example
# Optional email notification (Resend); all three values must be set to enable it.
RESEND_API_KEY=
HOPA_NOTIFICATION_EMAIL=
HOPA_NOTIFICATION_FROM=

# Optional Cloudflare Turnstile. Configure both site key in the frontend build and secret here.
HOPA_TURNSTILE_SECRET=
HOPA_TURNSTILE_HOSTNAME=
